{
  "name": "essay-anonymizer",
  "version": "1.2.0",
  "private": true,
  "description": "Removes writers' names from student essays (.docx, .pdf) for blind review. Runs entirely offline in the browser; rule-based, no AI. Made for the Writing Program Committee at Muhlenberg College.",
  "author": {
    "name": "Hamed Yaghoobian",
    "url": "https://hamedyaghoobian.com"
  },
  "homepage": "https://bergwriting.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bergwriting/bergwriting.github.io.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/rename-dist.mjs",
    "test": "vitest run",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xmldom/xmldom": "^0.9.8",
    "compromise": "^14.17.0",
    "docx": "^9.8.0",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
